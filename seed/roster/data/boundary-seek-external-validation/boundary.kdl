boundary "seek-external-validation" skill="boundary-seek-external-validation" owner="director" summary="Portfolio Director reaches outside the local frame, other roles work from locally observed evidence" order=3 {
    act "own" tool="WebSearch" "WebSearch the outside reference and cite the URL before any comparative, novelty, or market claim reaches a durable artifact"
    act "own" tool="WebFetch" "WebFetch the number off the source's own page rather than a report of it, and say plainly when you read only a summary"
    act "own" tool="AskUserQuestion" "AskUserQuestion every outward claim as a falsifiable option with your expectation stated before the answer is visible, because no other seat is permitted to catch this one"
    act "scoped" tool="WebFetch" "WebFetch the specific fact in front of you and read it to the bottom, rather than parking a question your grant already covers"
    act "scoped" tool="WebSearch" "WebSearch and one other modality, naming which you ran, because a single empty query is not a negative result"
    act "scoped" tool="create_issue" "create_issue for the portfolio-sized question your evidence points at, rather than letting a scoped reach decide one size larger than its grant"
    act "defer" tool="grep" "grep the local evidence first, and paste what it actually says"
    act "defer" tool="create_issue" "create_issue naming the outside question, the observation that would settle it, and what turns on the answer"
    act "defer" tool="AskUserQuestion" "AskUserQuestion when the outside fact is one the human already holds, rather than filing an issue to ask it"
}
