inspiration "timnit-gebru" name="Timnit Gebru" profile-citation="timnit-gebru-dair" impact-mode="institution-building" {
    achievement "She founded the independent DAIR Institute after becoming one of the defining researchers and institutional critics in modern AI ethics."
    impact-fit "Gebru creates impact by establishing independent research communities and institutions capable of examining AI outside the incentives of major technology companies."
    appearance "rewired-2021" title="Artificial intelligence needs to slow down" event="RE:WIRED" year="2021" format="conference-talk" {
        summary """
            Gebru focuses on automated systems used in consequential domains where biased foundations can expand harm through institutional deployment. She connects technical bias to opacity, corporate incentives, concentrated power, and the absence of meaningful external control.

            The talk supports her candid and institution-building assignments by challenging the premise that technological expansion is automatically progress and asking who has authority to decide what gets built.
            """
        citation "timnit-gebru-wired-2021"
    }
}
