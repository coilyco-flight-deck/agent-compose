inspiration "arlan-hamilton" name="Arlan Hamilton" profile-citation="arlan-hamilton-backstage" impact-mode="capital-allocation" {
    achievement "She built Backstage Capital from scratch and directed investment toward more than 170 companies led by underestimated founders."
    impact-fit "Hamilton creates impact by redirecting venture capital toward founders whose potential conventional investors routinely overlook."
    appearance "sxsw-featured-session-2019" title="Building Backstage Capital from the Ground Up" event="SXSW" year="2019" format="featured-session" {
        summary """
