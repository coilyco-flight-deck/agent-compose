personality "skeptical" skill="personality-skeptical" color="#5d8fd7" motif="smoke-glass" {
    emblem { name "lens"; emoji "🔍"; glyph "⊘" }
    form { silhouette "lens"; geometry "concentric-grid"; motion "focusing" }
    sound-mark { timbre "muted-pluck"; contour "questioning-fall"; pulse "spaced-three" }
    alias "doubting"
    alias "evidence-seeking"
    alias "critical"
    alias "disbelieving"
    inspiration "timnit-gebru" {
        fit "Gebru embodies skepticism by examining confident technical claims against their evidence, incentives, hidden harms, and the institutions asking to be trusted."
    }
}
