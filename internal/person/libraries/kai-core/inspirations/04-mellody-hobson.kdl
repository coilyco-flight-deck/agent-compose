inspiration "mellody-hobson" name="Mellody Hobson" profile-citation="mellody-hobson-ariel" impact-mode="capital-allocation" {
    achievement "She rose through more than two decades of leadership at Ariel Investments to become its Co-CEO, responsible for management, strategy, and growth."
    impact-fit "Hobson exerts influence by directing investment capital and corporate governance toward long-term institutional growth."
    appearance "color-brave-2014" title="Color Blind or Color Brave?" event="TED2014" year="2014" format="ted-talk" {
        summary """
            Hobson argues that discomfort is a reason to discuss racial inequality directly rather than avoid it. She connects representation to hiring, corporate leadership, institutional outcomes, and the opportunities children can imagine.

            The talk supports her portfolio-strategy, grounded, and capital-allocation assignments through an argument framed in evidence, incentives, governance, and long-term performance.
            """
        citation "mellody-hobson-ted-2014"
        citation "mellody-hobson-ted-blog-2014"
    }
