    inspiration "marian-croak" name="Marian Croak" profile-citation="marian-croak-ni" impact-mode="infrastructure" {
        achievement "Her foundational work advancing Voice over Internet Protocol helped make internet calling and modern audio and video conferencing practical."
        impact-fit "Croak changed the world by creating foundational communications technology that became part of the dependable infrastructure beneath modern internet calling."
        appearance "women-techmakers-2017" title="Women Techmakers Mountain View Summit keynote" event="Women Techmakers Mountain View Summit" year="2017" format="keynote" {
            summary """
                Croak traced her path from a child fascinated by repair workers to an engineer who built communications infrastructure. She joined autobiography with lessons about invention, product development, perseverance, and maintaining confidence while acknowledging hard realities.

                The appearance complements her engineer, meticulous, and infrastructure assignments by connecting personal curiosity, disciplined engineering, and technologies that became part of ordinary life.
                """
            citation "marian-croak-ada-lovelace-day"
            citation "marian-croak-duarte"
        }
    }

    inspiration "ava-duvernay" name="Ava DuVernay" profile-citation="ava-duvernay-array" impact-mode="cultural-storytelling" {
        achievement "She directed landmark works including Selma and the Academy Award-nominated documentary 13th while building ARRAY into an institution for narrative change."
        impact-fit "DuVernay creates impact by using film and media institutions to reshape how large audiences understand history, race, justice, and power."
        appearance "cornell-convocation-2018" title="Senior Convocation address" event="Cornell University Senior Convocation" year="2018" format="convocation-address" {
            summary """
                DuVernay asked graduates to define themselves deeply before careers, institutions, or other people did it for them. She used filmmaking language to make graduates responsible for interpreting and directing their own lives.

                The address expresses her director and reflective pairings by establishing a theme, placing individual lives within historical structure, and giving the audience agency over what comes next.
                """
            citation "ava-duvernay-cornell-2018"
        }
    }

    inspiration "angie-jones" name="Angie Jones" profile-citation="angie-jones-official" impact-mode="education-and-mentorship" {
        achievement "She became a Master Inventor with more than 25 patented software inventions while emerging as an influential test-automation educator."
        impact-fit "Jones multiplies her impact by translating deep software-testing expertise into teaching, mentorship, and practical tools that strengthen other engineers."
        appearance "testing-the-untestable" title="Testing the Untestable" event="Pacific Northwest Software Quality Conference" year="2019" format="keynote" {
