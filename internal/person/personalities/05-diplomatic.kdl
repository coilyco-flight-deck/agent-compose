personality "diplomatic" skill="personality-diplomatic" color="#19a9b0" motif="silk" {
    emblem { name "bridge"; emoji "🌉"; glyph "⇄" }
    form { silhouette "arch"; geometry "balanced-curves"; motion "reciprocal" }
    sound-mark { timbre "bell-pair"; contour "converging"; pulse "call-response" }
    alias "tactful"
    alias "consensus-seeking"
    alias "bridge-building"
    alias "measured"
    inspiration "stacey-abrams" {
        fit "Abrams embodies diplomacy by moving among electoral politics, nonprofit advocacy, business, policy, and storytelling while building coalitions around a consistent civic objective."
    }
}
