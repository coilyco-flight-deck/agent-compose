boundary "modify-live-backend" skill="boundary-modify-live-backend" owner="sysadmin" summary="Systems Administrator changes running backend systems, other roles observe and hand the action over" order=1 {
    act "own" tool="kubectl" "kubectl get -o wide and paste the before state"
    act "own" tool="kubectl rollout status" "kubectl rollout status after the change, re-read with the same get, and paste the after state in the same report"
    act "own" tool="git revert" "write the rollback line before the forward line: kubectl rollout undo, helm rollback, or git revert"
    act "scoped" tool="just" "just run, or the project's own launch verb, so the thing you are changing is one you started yourself"
    act "scoped" tool="kubectl" "kubectl config current-context, or the equivalent, and confirm it is the local one before the change rather than after"
    act "scoped" tool="create_issue" "create_issue the moment the same change is wanted on a hosted surface, rather than reaching for it because the command is identical"
    act "defer" tool="kubectl" "kubectl get, logs, and describe are reads and stay open to you: run them and paste the output"
    act "defer" tool="create_issue" "create_issue with the exact command you did not run and its expected result, so the owning seat runs one line rather than re-investigating"
    act "defer" tool="AskUserQuestion" "AskUserQuestion the sysadmin seat while it is live, rather than filing and waiting"
}
