boundary "suggest-external-comms" skill="boundary-suggest-external-comms" owner="advocate" summary="Developer Advocate recommends communication addressed outward, other roles keep their own factual records" order=2 {
    act "own" tool="create_draft" "create_draft in the real channel and leave it unsent, rather than proposing that a message be produced"
    act "own" tool="get_thread" "get_thread before writing into a thread, so the reply answers what is already there"
    act "own" tool="WebSearch" "WebSearch how the audience already phrases the thing before you choose words for them"
    act "scoped" tool="grep" "grep the surface for every string you are about to change, so the edit stays bounded by the artifact you own"
    act "scoped" tool="git diff" "git diff and confirm the change is words only, with control flow, state, and contracts untouched"
    act "scoped" tool="AskUserQuestion" "AskUserQuestion the owning seat the moment a label starts becoming a sentence addressed outward"
    act "defer" tool="create_issue" "create_issue carrying the factual record and the recipient, with no drafted wording in the body"
    act "defer" tool="get_thread" "get_thread and attach what was already said, so the advocate seat does not re-derive the conversation"
    act "defer" tool="AskUserQuestion" "AskUserQuestion the seat that owns the words, rather than writing them yourself because the prose was nearby"
}
