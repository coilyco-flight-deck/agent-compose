boundary "build-foundational-software" skill="boundary-build-foundational-software" owner="platform" summary="Platform Engineer builds and lands foundational software, other roles specify what it must do and hand the build over" order=4 {
    act "own" tool="just" "just check and pre-commit run --all-files before reporting it done"
    act "own" tool="git commit" "git commit the docs/FEATURES.md entry in the same commit as the capability that earned it"
    act "own" tool="pytest" "pytest or go test the consumer and not only the library, because the contract is what callers get"
    act "scoped" tool="git diff" "git diff and confirm the change stayed inside your named scope, because the seam is where a scoped build becomes a shared one"
    act "scoped" tool="go test" "go test or pytest your own runner, probe, or grader before it produces a number anyone quotes"
    act "scoped" tool="create_issue" "create_issue naming the shared tooling your work wants, rather than building it because you were already in the file"
    act "defer" tool="create_issue" "create_issue stating what the software must do and the exact invocation that would prove it"
    act "defer" tool="pytest" "pytest or go test the failing case and paste its output, so the owning seat starts from a reproduction"
    act "defer" tool="AskUserQuestion" "AskUserQuestion the owning seat with the failing command, rather than fixing it because you were already in the file"
}
