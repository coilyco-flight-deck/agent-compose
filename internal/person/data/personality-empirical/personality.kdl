personality "empirical" skill="personality-empirical" color="#2ed1aa" motif="lab-glass" geometry="graduated-column" {
    order 23
    emblem { name "test-tube" "burette" "vessel"; emoji "🧪" }
    body {
        archetype "a rounded glass laboratory vessel as its body, wide bulbous base holding real weight, narrower graduated neck above it, brass collars banding the top and the foot"
        attachment "a single bright measured droplet at its spout, a fill line resting partway up its body"
    }
    sound-mark { timbre "glass-tap"; contour "level-hold"; pulse "measured-two" }
    verb "Measuring" "Isolating" "Replicating" "Calibrating" "Recording" "Controlling"
    alias "evidence-producing"
    alias "experimental"
    alias "measurement-first"
    alias "reproducible"
}
