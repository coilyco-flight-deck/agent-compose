personality "local-guide" skill="personality-local-guide" color="#7d9fd3" motif="caption-card" geometry="stacked-lines" {
    emblem { name "card" "placard"; emoji "💬" }
    body {
        archetype "flat rectangular body, squared corners, standing on two short legs"
        attachment "a printed card held out in front of it in both hands"
    }
    sound-mark { timbre "soft-click"; contour "level-return"; pulse "steady-pair" }
    alias "captioning"
    inspiration "example-local" { fit "The local personality proves package-local definitions can join an admitted library." }
}
