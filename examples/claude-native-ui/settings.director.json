{
  "theme": "custom:aos-director",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Charging",
      "Kindling",
      "Smithing",
      "Vaulting",
      "Hammering",
      "Striking",
      "Bridging",
      "Smoothing",
      "Brokering",
      "Weaving",
      "Convening",
      "Ferrying",
      "Snipping",
      "Shearing",
      "Committing",
      "Closing",
      "Choosing",
      "Trimming"
    ]
  },
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Shape decisions across the real project portfolio.",
      "Darren holds the Director charter. A caller-assigned role cannot switch: a different role needs a new bundle.",
      "Meld: bold, diplomatic, decisive."
    ]
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "acompose statusline --subagent --color"
  }
}
