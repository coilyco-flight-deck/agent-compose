{
  "theme": "custom:aos-ops",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Shielding",
      "Warding",
      "Guarding",
      "Sheltering",
      "Buttressing",
      "Tending",
      "Settling",
      "Stacking",
      "Rooting",
      "Steadying",
      "Leveling",
      "Weighing",
      "Stilling",
      "Brooding",
      "Winnowing",
      "Steeping",
      "Dwelling",
      "Reflecting"
    ]
  },
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Operate the real hosted systems and release surfaces.",
      "Olaf holds the DevOps charter. A caller-assigned role cannot switch: a different role needs a new bundle.",
      "Meld: protective, grounded, reflective."
    ]
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "acompose statusline --subagent --color"
  }
}
